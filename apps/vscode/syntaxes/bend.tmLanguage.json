{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bend 2",
  "scopeName": "source.bend",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.number-sign.bend", "match": "#.*$" }]
    },
    "strings": {
      "patterns": [{ "name": "string.quoted.double.bend", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.bend", "match": "\\\\." }] }]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.bend", "match": "\\b(?:0|[1-9][0-9]*)(?:n|u|f)?\\b" }]
    },
    "declarations": {
      "patterns": [
        { "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.function.bend" }, "2": { "name": "entity.name.function.bend" } } },
        { "match": "\\b(law)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.other.law.bend" }, "2": { "name": "entity.name.function.law.bend" } } },
        { "match": "\\b(type)\\s+((?:[A-Za-z_][A-Za-z0-9_]*\\.)*[A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.bend" }, "2": { "name": "entity.name.type.bend" } } }
      ]
    },
    "keywords": {
      "patterns": [{ "name": "keyword.control.bend", "match": "\\b(?:import|as|match|case|let|do|for|exs|where|is|return)\\b" }]
    },
    "types": {
      "patterns": [{ "name": "support.type.bend", "match": "\\b(?:Nat|U32|F32|Bool|String|Unit|IO|List|Array|True|False)\\b" }]
    },
    "operators": {
      "patterns": [{ "name": "keyword.operator.bend", "match": "(?:==|!=|<=|>=|->|=>|::|\\+\\+|[+*=/<>!%:-])" }]
    }
  }
}
